# 智谱 AI（bigmodel.cn）API Key —— 从 https://bigmodel.cn 控制台获取
# 复制本文件为 .env 并填入真实值（.env 不应提交到版本库）
ZHIPU_API_KEY=你的智谱APIKey

# 对话模型，默认 glm-4-flash（免费），可按需改为 glm-5.2 / glm-4.5-air 等
ZHIPU_MODEL=glm-4-flash

# 本地 MySQL 连接（数据库存储用户信息，对应 tasks.md 数据库设计）
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你的MySQL密码
DB_NAME=ai_chat_todo

# 后端端口（前端 dev 下将 /api 代理到该端口）
PORT=3001
